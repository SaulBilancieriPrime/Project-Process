AZURE_SQL_SERVER=sql-prime-it.database.windows.net
AZURE_SQL_DATABASE=atg-requirements
PORT=5174
FRONTEND_URL=http://127.0.0.1:5173

# Local dev (same as PM_MANUAL):
# 1. Install ODBC Driver 18 for SQL Server (64-bit)
# 2. az login
# 3. .\.venv\Scripts\python.exe server\app.py   (terminal 1 — use venv Python)
# 4. npm run dev                                  (terminal 2)
# Check: http://127.0.0.1:5174/api/health  (odbcDrivers + sql:true)
